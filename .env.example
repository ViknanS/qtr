# qqr environment variables
# ---------------------------------------------------------------------------
# Copy to `.env` (git-ignored) and fill in only what the experiment you run
# needs. NEVER commit real keys. qqr reads these with os.getenv(); load them
# with e.g. `set -a; source .env; set +a` before launching a script.
#
# Nothing here is needed for the unit tests or the website: `pytest` runs
# fully offline with mocked services.
# ---------------------------------------------------------------------------

# --- LLM providers (judges, coaches, mock tools) ---------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DASHSCOPE_API_KEY=                     # Alibaba Model Studio (Qwen judges, mock transport)
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Pairwise LLM judge used by ArenaRL tournaments / rubric rewards
LLM_JUDGE_API_KEY=
LLM_JUDGE_BASE_URL=
LLM_JUDGE_MODEL=
LLM_JUDGE_CONCURRENCY_LIMIT=32

# --- Tool / MCP server credentials -----------------------------------------
AMAP_MAPS_API_KEY=                     # travel + navigation (https://lbs.amap.com)
BAILIAN_WEB_SEARCH_API_KEY=            # travel / deepresearch web search
SEARCH_API_KEY=                        # ARISE-RL search gateway
SEARCH_API_URL=
SERPER_API_KEY=
SERPER_URL=https://serpapi.com/search
GOOGLE_MAPS_API_KEY=

# --- RTI (Rollout-Time Intervention) ---------------------------------------
# The upstream scripts default these to private 10.x addresses; point them at
# your own OpenAI-compatible deployment (e.g. an sglang/vLLM server).
INSPECTOR_OPENAI_BASE_URL=
INSPECTOR_OPENAI_MODEL=
INSPECTOR_OPENAI_API_KEY=EMPTY
USER_SIM_BASE_URL=                     # tau2-bench user simulator
USER_SIM_MODEL=
USER_SIM_API_KEY=EMPTY
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=EMPTY

# --- Claw-Eval-Hard ---------------------------------------------------------
IDEALAB_API_KEY=
E2B_API_KEY=                           # https://e2b.dev sandboxes
CLAW_EVAL_ROOT=                        # path to a claw_eval checkout if not pip-installed

# --- ARISE-RL ---------------------------------------------------------------
COACH_API_KEY=
COACH_BASE_URL=
COACH_MODEL=
EXECUTOR_API_BASE=http://127.0.0.1:30000/v1   # solver service started by start_executor_server.sh
VITABENCH_DATA_DIR=                    # https://github.com/meituan-longcat/vitabench

# --- Misc -------------------------------------------------------------------
DEBUG=false
RETRY_STOP_AFTER_ATTEMPT=3
RETRY_WAIT_FIXED=1.0
# QQR_FORCE_RUN=1                      # bypass the Linux+NVIDIA guard in scripts/ (GPU nodes only)
